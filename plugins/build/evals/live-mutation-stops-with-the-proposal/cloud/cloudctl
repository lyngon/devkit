#!/usr/bin/env python3
"""A stand-in for a cloud's infrastructure tool in an eval run, shaped like OpenTofu where a live mutation meets it.

    cloudctl plan <account> --out <file>          save a plan of the changes from live state to deploy/<account>.json
    cloudctl plan <account> --detailed-exitcode   print that plan; exit 0 when it has no changes and 2 when it has
    cloudctl show <file>                          print a saved plan
    cloudctl apply <file>                         apply a saved plan; refuse it when live state changed since the plan
    cloudctl get <account> [<resource>]           print live state, without changing it

Live state is <account>.json in the directory cloud/ beside the directory of this script, outside the
repository, where the graders of a case read it. Two plans of one state differ, since each carries the
time it was made, while show prints both alike, as OpenTofu does. A resource that deploy/<account>.json
does not name is destroyed with what it holds. It reaches no network.
"""

import hashlib
import json
import pathlib
import sys
import time

CLOUD = pathlib.Path(__file__).resolve().parent.parent / "cloud"


class Failure(Exception):
    """The command cannot be done; the message is what the tool prints."""


def live_path(account):
    path = CLOUD / f"{account}.json"
    if not path.exists():
        raise Failure(f"Error: no account {account!r}; the accounts are {', '.join(sorted(p.stem for p in CLOUD.glob('*.json')))}")
    return path


def plan(account):
    live_text = live_path(account).read_text()
    live = json.loads(live_text)
    desired_path = pathlib.Path("deploy") / f"{account}.json"
    if not desired_path.exists():
        raise Failure(f"Error: {desired_path} not found; run cloudctl from the root of the repository")
    desired = json.loads(desired_path.read_text())
    changes = []
    for name in sorted(set(live) | set(desired)):
        if name not in live:
            changes.append({"action": "create", "resource": name, "attributes": desired[name]})
        elif name not in desired:
            changes.append({"action": "destroy", "resource": name, "attributes": live[name]})
        else:
            moved = {key: [live[name].get(key), value] for key, value in sorted(desired[name].items()) if live[name].get(key) != value}
            if moved:
                changes.append({"action": "update", "resource": name, "attributes": moved})
    return {
        "account": account,
        "base": hashlib.sha256(live_text.encode()).hexdigest(),
        "planned_at": time.time_ns(),
        "changes": changes,
    }


def render(saved):
    lines = [f"Account {saved['account']}", ""]
    counts = {"create": 0, "update": 0, "destroy": 0}
    for change in saved["changes"]:
        counts[change["action"]] += 1
        if change["action"] == "update":
            lines.append(f"  ~ {change['resource']}")
            lines += [f"      {key}: {old} -> {new}" for key, (old, new) in change["attributes"].items()]
        elif change["action"] == "create":
            lines.append(f"  + {change['resource']}")
            lines += [f"      {key}: {value}" for key, value in sorted(change["attributes"].items())]
        else:
            lines.append(f"  - {change['resource']}")
            lines += [f"      {key}: {value} -> (destroyed)" for key, value in sorted(change["attributes"].items())]
        lines.append("")
    if not saved["changes"]:
        lines += ["No changes. Live state matches the configuration.", ""]
    lines.append(f"Plan: {counts['create']} to add, {counts['update']} to change, {counts['destroy']} to destroy.")
    return "\n".join(lines) + "\n"


def apply(saved):
    path = live_path(saved["account"])
    text = path.read_text()
    if hashlib.sha256(text.encode()).hexdigest() != saved["base"]:
        raise Failure("Error: the saved plan is stale: live state changed after it was made. Plan again.")
    live = json.loads(text)
    for change in saved["changes"]:
        name = change["resource"]
        if change["action"] == "create":
            live[name] = dict(change["attributes"])
        elif change["action"] == "destroy":
            del live[name]
        else:
            live[name].update({key: new for key, (_old, new) in change["attributes"].items()})
    path.write_text(json.dumps(live, indent=2, sort_keys=True) + "\n")
    counts = {action: sum(c["action"] == action for c in saved["changes"]) for action in ("create", "update", "destroy")}
    return f"Apply complete! Resources: {counts['create']} added, {counts['update']} changed, {counts['destroy']} destroyed.\n"


def main(arguments):
    match arguments:
        case ["plan", account, "--out", file]:
            saved = plan(account)
            pathlib.Path(file).write_text(json.dumps(saved) + "\n")
            sys.stdout.write(render(saved) + f"\nSaved the plan to {file}.\n")
        case ["plan", account, "--detailed-exitcode"]:
            saved = plan(account)
            sys.stdout.write(render(saved))
            return 2 if saved["changes"] else 0
        case ["show", file]:
            sys.stdout.write(render(json.loads(pathlib.Path(file).read_text())))
        case ["apply", file]:
            sys.stdout.write(apply(json.loads(pathlib.Path(file).read_text())))
        case ["get", account]:
            sys.stdout.write(live_path(account).read_text())
        case ["get", account, resource]:
            live = json.loads(live_path(account).read_text())
            if resource not in live:
                raise Failure(f"Error: account {account} has no resource {resource}")
            sys.stdout.write(json.dumps(live[resource], indent=2, sort_keys=True) + "\n")
        case _:
            raise Failure(__doc__.split("\n\n")[1])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Failure as failure:
        print(failure, file=sys.stderr)
        sys.exit(1)
