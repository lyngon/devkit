# Agent scratch output. May be deleted at any time.
/tmp/
# Human experiments. May live for weeks, never committed.
/sandbox/

# devenv (generated or per-user)
.devenv*
devenv.local.nix
devenv.local.yaml
.pre-commit-config.yaml
.mcp.json

# direnv
.direnv/

# Claude Code per-user overrides (.claude/settings.json is committed)
.claude/settings.local.json
# Claude Code session worktrees
.claude/worktrees/

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Eval runs, of the whole checkout and of one plugin
/evals/results/
plugins/*/evals/results/
# The session that a run resumes from a case's history_file, which Claude Code
# goes on writing beside that file, named by the session's ID
plugins/*/evals/*/*-*-*-*-*.jsonl
plugins/*/evals/*/*-*-*-*-*/

# Python bytecode caches from the validators
__pycache__/
